# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C, C++ and shell use tabs, as the existing sources do.
[*.{c,h,cpp,hpp}]
indent_style = tab
indent_size = 8
max_line_length = 80

[*.sh]
indent_style = tab
indent_size = 8

[*.{py,yml,yaml,json}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown gives two trailing spaces a meaning (a hard line break).
trim_trailing_whitespace = false

# Vendored code keeps whatever upstream uses; do not reformat it.
[third_party/**]
indent_style = unset
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = false
insert_final_newline = unset
